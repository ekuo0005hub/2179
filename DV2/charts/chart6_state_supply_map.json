{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average Water Runoff by State (2001-2021)",
    "subtitle": "NSW dominates upstream water availability; SA receives the least",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "color": "#1a1a2e",
    "subtitleColor": "#555"
  },
  "width": "container",
  "height": 380,
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {
    "type": "mercator",
    "center": [136, -28],
    "scale": 650
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ddeee8",
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "strokeOpacity": 1
      }
    },
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {"url": "data/state_avg_supply.csv"},
            "key": "STATE_NAME",
            "fields": ["avg_runoff_GL"]
          }
        },
        {"filter": "datum.avg_runoff_GL != null"}
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "strokeOpacity": 1
      },
      "encoding": {
        "color": {
          "field": "avg_runoff_GL",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [0, 3500]
          },
          "legend": {
            "title": "Avg Runoff (GL)",
            "orient": "bottom-right",
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {"field": "properties.STATE_NAME", "type": "nominal", "title": "State"},
          {"field": "avg_runoff_GL", "type": "quantitative", "title": "Avg Runoff (GL)", "format": ",.0f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 146.5, "lat": -32.0, "label": "NSW  3,385 GL"},
          {"lon": 143.5, "lat": -36.8, "label": "VIC  1,463 GL"},
          {"lon": 135.5, "lat": -31.0, "label": "SA  230 GL"},
          {"lon": 121.0, "lat": -25.5, "label": "WA"},
          {"lon": 133.0, "lat": -19.5, "label": "NT"},
          {"lon": 146.5, "lat": -22.0, "label": "QLD"},
          {"lon": 146.5, "lat": -42.0, "label": "TAS"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1a1a2e",
        "opacity": 0.75
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ]
}
